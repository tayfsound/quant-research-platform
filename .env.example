# AI Quant Research Platform - Ortam Değişkenleri Şablonu
# Bu dosyayı .env olarak kopyalayıp değerleri doldurun.

# Veritabanı
DATABASE_URL=postgresql+asyncpg://quant:quantpass@localhost:5432/quantdb
DATABASE_URL_SYNC=postgresql+psycopg2://quant:quantpass@localhost:5432/quantdb
TIMESCALE_URL=postgresql+asyncpg://quant:quantpass@localhost:5432/quantdb

# Redis
REDIS_URL=redis://localhost:6379/0

# Borsa API'leri (sadece okuma izni olan key'ler)
BINANCE_API_KEY=
BINANCE_API_SECRET=
BYBIT_API_KEY=
BYBIT_API_SECRET=
OKX_API_KEY=
OKX_API_SECRET=
COINBASE_API_KEY=
COINBASE_API_SECRET=
KRAKEN_API_KEY=
KRAKEN_API_SECRET=

# Güvenlik
SECRET_KEY=degistirin-cok-gizli-bir-anahtar
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
# Boşsa ilk /auth/register çağrısı otomatik ADMIN olur (dev modu). Prod'da
# doldurun — ilk admin bootstrap'ı sadece bu token'ı bilen yapabilir.
ADMIN_SETUP_TOKEN=

# Uygulama
APP_ENV=development
LOG_LEVEL=DEBUG
API_PORT=8000
DASHBOARD_PORT=5173

# pgvector
PGVECTOR_EMBEDDING_DIM=384

# Risk (imza anahtarı yolu)
RISK_SIGNING_KEY_PATH=./keys/risk_private.pem

# TradingView webhook — boşsa doğrulama atlanır (dev modu). Doldurulursa
# gelen alert JSON'ındaki "secret" alanı bununla eşleşmeli.
TRADINGVIEW_WEBHOOK_SECRET=
